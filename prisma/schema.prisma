generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model operation_receipts {
  id                  String   @id @default(uuid()) @db.Uuid
  actor_id            BigInt
  operation           String   @db.VarChar(60)
  idempotency_key     String   @db.VarChar(128)
  request_fingerprint String   @db.VarChar(64)
  result_json         Json
  created_at          DateTime @default(now()) @db.Timestamp(6)

  @@unique([actor_id, operation, idempotency_key])
}

model evaluation_activity {
  id            BigInt   @id @default(autoincrement())
  evaluation_id BigInt
  action        String   @db.VarChar(30)
  occurred_at   DateTime @default(now()) @db.Timestamp(6)
  actor_id      BigInt?
  actor_name    String?  @db.VarChar(150)
  before_json   Json?
  after_json    Json?

  @@index([evaluation_id, occurred_at, id])
}

model setup_audit {
  id                  BigInt   @id @default(autoincrement())
  destination_year_id BigInt
  source_year_id      BigInt?
  actor_id            BigInt
  details             Json
  created_at          DateTime @default(now()) @db.Timestamp(6)
}

model answers {
  id             BigInt           @id @default(autoincrement())
  response_id    BigInt
  question_id    BigInt
  rating_value   Int?
  text_value     String?
  created_at     DateTime         @db.Timestamp(6)
  questions      questions        @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responses      responses        @relation(fields: [response_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answer_options answer_options[]

  @@unique([response_id, question_id], map: "answers_response_id_question_id_idx")
}

model answer_options {
  answer_id BigInt
  option_id BigInt

  answers          answers          @relation(fields: [answer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question_options question_options @relation(fields: [option_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([answer_id, option_id])
}

model assessment_drafts {
  id                BigInt   @id @default(autoincrement())
  participant_id    BigInt   @unique
  survey_version_id BigInt?
  answers_json      Json
  created_at        DateTime @db.Timestamp(6)
  updated_at        DateTime @db.Timestamp(6)

  evaluation_participants evaluation_participants @relation(fields: [participant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  survey_versions         survey_versions?        @relation("DraftSurveyVersion", fields: [survey_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model academic_years {
  // SQL owns the one-active partial index and numeric-year/date CHECKs.
  id         BigInt    @id @default(autoincrement())
  name       String    @unique @db.VarChar(20)
  start_year Int?
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  is_active  Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt @db.Timestamp(6)

  semesters                    semesters[]
  student_generations          student_generations[]
  student_academic_records     student_academic_records[]
  course_offering_group_scopes course_offering_group_scopes[]
  evaluation_group_targets     evaluation_group_targets[]
  curriculum_revisions         curriculum_revisions[]
}

model departments {
  id         BigInt            @id @default(autoincrement())
  code       String            @unique @db.VarChar(30)
  name       String            @unique @db.VarChar(150)
  status     department_status @default(ACTIVE)
  created_at DateTime          @default(now()) @db.Timestamp(6)
  updated_at DateTime          @updatedAt @db.Timestamp(6)

  user_departments user_departments[]
  courses          courses[]
  majors           majors[]
}

model user_departments {
  user_id       BigInt
  department_id BigInt
  is_primary    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamp(6)

  users       users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments departments @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // SQL migration owns the partial unique index on user_id WHERE is_primary = TRUE.
  // Keep this composite key: users may have multiple non-primary memberships.
  @@id([user_id, department_id])
}

model majors {
  id            BigInt   @id @default(autoincrement())
  code          String   @unique @db.VarChar(30)
  name          String   @db.VarChar(150)
  department_id BigInt
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  departments                  departments                    @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_academic_records     student_academic_records[]
  course_year_rules            course_year_rules[]
  course_offering_group_scopes course_offering_group_scopes[]
  evaluation_group_targets     evaluation_group_targets[]
  student_generations          student_generations[]

  @@unique([department_id, name], map: "majors_department_id_name_idx")
}

model student_generations {
  // SQL owns starting_year_level BETWEEN 1 AND 5.
  id                     BigInt   @id @default(autoincrement())
  // Retained display/legacy label; identity is (major_id, generation_number).
  name                   String   @db.VarChar(100)
  major_id               BigInt?
  generation_number      Int?
  entry_academic_year_id BigInt
  starting_year_level    Int      @default(1)
  created_at             DateTime @default(now()) @db.Timestamp(6)
  updated_at             DateTime @updatedAt @db.Timestamp(6)

  entry_academic_year          academic_years                  @relation(fields: [entry_academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  majors                       majors?                         @relation(fields: [major_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                     students[]
  evaluation_targets           evaluation_generation_targets[]
  course_offering_group_scopes course_offering_group_scopes[]
  evaluation_group_targets     evaluation_group_targets[]

  @@unique([major_id, generation_number])
}

model students {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt   @unique
  student_code  String   @unique @db.VarChar(50)
  generation_id BigInt
  notes         String?
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  users                    users                      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_generations      student_generations        @relation(fields: [generation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_academic_records student_academic_records[]
}

model student_academic_records {
  // SQL owns year_level BETWEEN 1 AND 5.
  id                 BigInt                     @id @default(autoincrement())
  student_id         BigInt
  academic_year_id   BigInt
  year_level         Int
  major_id           BigInt
  class_group        String?                    @db.VarChar(50)
  progression_action student_progression_action @default(NORMAL)
  created_at         DateTime                   @default(now()) @db.Timestamp(6)
  updated_at         DateTime                   @updatedAt @db.Timestamp(6)

  students       students       @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academic_years academic_years @relation(fields: [academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  majors         majors         @relation(fields: [major_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, academic_year_id], map: "student_academic_records_student_id_academic_year_id_idx")
}

model course_offerings {
  // SQL owns the nullable level CHECK and NULLS NOT DISTINCT on the index below.
  // Keep the six-field compound selector; migrate deploy preserves SQL semantics.
  id                 BigInt      @id @default(autoincrement())
  course_id          BigInt
  lecturer_id        BigInt
  semester_id        BigInt
  year_level         Int?
  class_type         class_type?
  section_code       String?     @db.VarChar(50)
  source_offering_id BigInt?
  created_at         DateTime    @db.Timestamp(6)
  updated_at         DateTime    @db.Timestamp(6)

  courses      courses                        @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users                          @relation(fields: [lecturer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  semesters    semesters                      @relation(fields: [semester_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments  enrollments[]
  evaluations  evaluations[]
  group_scopes course_offering_group_scopes[]

  @@unique([course_id, lecturer_id, semester_id, year_level, class_type, section_code], map: "course_offerings_assignment_unique_idx")
}

model course_offering_group_scopes {
  // SQL owns year_level BETWEEN 1 AND 5.
  id                     BigInt   @id @default(autoincrement())
  course_offering_id     BigInt
  academic_year_id       BigInt
  generation_id          BigInt
  major_id               BigInt
  year_level             Int
  class_group            String   @db.VarChar(50)
  curriculum_revision_id BigInt?
  created_at             DateTime @default(now()) @db.Timestamp(6)

  course_offerings    course_offerings      @relation(fields: [course_offering_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academic_years      academic_years        @relation(fields: [academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_generations student_generations   @relation(fields: [generation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  majors              majors                @relation(fields: [major_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  curriculum_revision curriculum_revisions? @relation(fields: [curriculum_revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([course_offering_id, academic_year_id, generation_id, major_id, year_level, class_group], map: "course_offering_group_scope_unique_idx")
  @@index([academic_year_id, generation_id, major_id, year_level], map: "course_offering_group_scope_context_idx")
  @@index([curriculum_revision_id])
}

model courses {
  id            BigInt   @id @default(autoincrement())
  course_code   String   @unique @db.VarChar(30)
  course_name   String   @db.VarChar(150)
  description   String?
  department_id BigInt
  created_at    DateTime @db.Timestamp(6)
  updated_at    DateTime @db.Timestamp(6)

  departments       departments         @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course_offerings  course_offerings[]
  course_year_rules course_year_rules[]
}

model course_year_rules {
  // SQL owns year_level BETWEEN 1 AND 5.
  id         BigInt   @id @default(autoincrement())
  course_id  BigInt
  major_id   BigInt
  year_level Int
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  courses   courses                @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  majors    majors                 @relation(fields: [major_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions curriculum_revisions[]

  @@unique([course_id, major_id, year_level], map: "course_year_rules_course_major_year_idx")
}

// Append-only approvals for a stable course/major/year-level rule. Moving a
// course to another level means disabling this rule and approving a new rule.
model curriculum_revisions {
  id                         BigInt   @id @default(autoincrement())
  rule_id                    BigInt
  revision_no                Int
  effective_academic_year_id BigInt
  effective_start_year       Int
  enabled                    Boolean
  reason                     String?  @db.VarChar(2000)
  created_at                 DateTime @default(now()) @db.Timestamp(6)

  rule           course_year_rules              @relation(fields: [rule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academic_years academic_years                 @relation(fields: [effective_academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group_scopes   course_offering_group_scopes[]

  @@unique([rule_id, revision_no])
  @@unique([rule_id, effective_start_year])
}

model enrollments {
  id                 BigInt   @id @default(autoincrement())
  student_id         BigInt
  course_offering_id BigInt
  enrolled_at        DateTime @db.Timestamp(6)

  course_offerings course_offerings @relation(fields: [course_offering_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users            @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, course_offering_id], map: "enrollments_student_id_course_offering_id_idx")
}

model evaluation_participants {
  id                 BigInt    @id @default(autoincrement())
  evaluation_id      BigInt
  student_id         BigInt
  survey_version_id  BigInt?
  has_submitted      Boolean   @default(false)
  submitted_at       DateTime? @db.Timestamp(6)
  placement_snapshot Json?
  created_at         DateTime  @db.Timestamp(6)

  evaluations       evaluations        @relation(fields: [evaluation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users              @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  survey_versions   survey_versions?   @relation("ParticipantSurveyVersion", fields: [survey_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment_drafts assessment_drafts?

  @@unique([evaluation_id, student_id], map: "evaluation_participants_evaluation_id_student_id_idx")
}

model evaluations {
  // SQL owns the nullable timestamp ordering CHECK.
  id                 BigInt                       @id @default(autoincrement())
  course_offering_id BigInt
  survey_version_id  BigInt
  participant_scope  evaluation_participant_scope @default(ALL_ENROLLED)
  status             evaluation_status            @default(DRAFT)
  start_at           DateTime?                    @db.Timestamp(6)
  end_at             DateTime?                    @db.Timestamp(6)
  created_by         BigInt
  created_at         DateTime                     @db.Timestamp(6)
  updated_at         DateTime                     @db.Timestamp(6)

  evaluation_participants evaluation_participants[]
  generation_targets      evaluation_generation_targets[]
  group_targets           evaluation_group_targets[]
  course_offerings        course_offerings                @relation(fields: [course_offering_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                   users                           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  survey_versions         survey_versions                 @relation(fields: [survey_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responses               responses[]

  @@unique([course_offering_id, survey_version_id], map: "evaluations_course_offering_id_survey_version_id_idx")
}

model evaluation_generation_targets {
  evaluation_id      BigInt
  generation_id      BigInt
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  historical_labels  Json?
  labels_captured_at DateTime? @db.Timestamp(6)

  evaluations         evaluations         @relation(fields: [evaluation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_generations student_generations @relation(fields: [generation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([evaluation_id, generation_id])
}

model evaluation_group_targets {
  // SQL owns year_level BETWEEN 1 AND 5 in addition to historical-label protection.
  id                 BigInt    @id @default(autoincrement())
  evaluation_id      BigInt
  academic_year_id   BigInt
  generation_id      BigInt
  major_id           BigInt
  year_level         Int
  class_group        String    @db.VarChar(50)
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  historical_labels  Json?
  labels_captured_at DateTime? @db.Timestamp(6)

  evaluations         evaluations         @relation(fields: [evaluation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  academic_years      academic_years      @relation(fields: [academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_generations student_generations @relation(fields: [generation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  majors              majors              @relation(fields: [major_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([evaluation_id, academic_year_id, generation_id, major_id, year_level, class_group], map: "evaluation_group_target_unique_idx")
  @@index([academic_year_id, generation_id, major_id, year_level], map: "evaluation_group_target_context_idx")
}

model questions {
  id                BigInt        @id @default(autoincrement())
  survey_version_id BigInt
  question_text     String
  question_text_km  String?
  question_type     question_type
  category          String?       @db.VarChar(100)
  is_required       Boolean       @default(true)
  min_rating        Int?
  max_rating        Int?
  display_order     Int
  created_at        DateTime      @db.Timestamp(6)
  updated_at        DateTime      @db.Timestamp(6)

  answers          answers[]
  question_options question_options[]
  survey_versions  survey_versions    @relation(fields: [survey_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([survey_version_id, display_order], map: "questions_survey_version_id_display_order_idx")
}

model question_options {
  id            BigInt @id @default(autoincrement())
  question_id   BigInt
  option_text   String
  display_order Int

  questions      questions        @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answer_options answer_options[]

  @@unique([question_id, display_order], map: "question_options_question_id_display_order_idx")
}

model responses {
  id                   BigInt   @id @default(autoincrement())
  evaluation_id        BigInt
  survey_version_id    BigInt?
  // Anonymous evaluation-time cohort tag; never a student/participant reference.
  audience_major_id    BigInt?
  audience_major_label Json?
  submitted_at         DateTime @db.Timestamp(6)
  created_at           DateTime @db.Timestamp(6)

  answers         answers[]
  evaluations     evaluations      @relation(fields: [evaluation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  survey_versions survey_versions? @relation("ResponseSurveyVersion", fields: [survey_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model semesters {
  // SQL owns the nullable calendar-date ordering CHECK.
  id               BigInt    @id @default(autoincrement())
  semester_name    String    @db.VarChar(50)
  semester_number  Int?
  academic_year_id BigInt
  start_date       DateTime? @db.Date
  end_date         DateTime? @db.Date
  created_at       DateTime  @db.Timestamp(6)
  updated_at       DateTime  @db.Timestamp(6)

  academic_years   academic_years     @relation(fields: [academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course_offerings course_offerings[]

  @@unique([academic_year_id, semester_name], map: "semesters_academic_year_id_semester_name_idx")
  @@unique([academic_year_id, semester_number], map: "semesters_academic_year_id_semester_number_idx")
}

model surveys {
  // SQL owns survey_title_key(text), global normalized uniqueness and nonblank CHECK.
  id          BigInt    @id @default(autoincrement())
  title       String    @db.VarChar(200)
  description String?
  archived_at DateTime? @db.Timestamp(6)
  created_by  BigInt
  created_at  DateTime  @db.Timestamp(6)
  updated_at  DateTime  @db.Timestamp(6)

  survey_versions survey_versions[]
  users           users             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model survey_versions {
  id         BigInt                @id @default(autoincrement())
  survey_id  BigInt
  version_no Int
  status     survey_version_status @default(DRAFT)
  locked_at  DateTime?
  created_by BigInt
  created_at DateTime              @db.Timestamp(6)

  surveys                 surveys                   @relation(fields: [survey_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                   users                     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions               questions[]
  evaluations             evaluations[]
  evaluation_participants evaluation_participants[] @relation("ParticipantSurveyVersion")
  assessment_drafts       assessment_drafts[]       @relation("DraftSurveyVersion")
  responses               responses[]               @relation("ResponseSurveyVersion")

  @@unique([survey_id, version_no], map: "survey_versions_survey_id_version_no_idx")
}

model users {
  id            BigInt      @id @default(autoincrement())
  email         String?     @unique @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  full_name     String      @db.VarChar(150)
  gender        gender?
  role          user_role
  status        user_status @default(ACTIVE)
  auth_version  Int         @default(0)
  created_at    DateTime    @db.Timestamp(6)
  updated_at    DateTime    @db.Timestamp(6)

  course_offerings        course_offerings[]
  enrollments             enrollments[]
  evaluation_participants evaluation_participants[]
  evaluations             evaluations[]
  surveys                 surveys[]
  survey_versions         survey_versions[]
  user_departments        user_departments[]
  student                 students?
  reviewed_operations     reviewed_operations[]
}

// Administrative previews/results only; never anonymous response content.
model reviewed_operations {
  id                   String    @id @default(uuid()) @db.Uuid
  operation_kind       String    @db.VarChar(40)
  actor_id             BigInt
  resource_key         String    @db.VarChar(100)
  request_json         Json
  request_fingerprint  String    @db.Char(64)
  snapshot_fingerprint String    @db.Char(64)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  expires_at           DateTime  @db.Timestamp(6)
  completed_at         DateTime? @db.Timestamp(6)
  result_json          Json?

  actor users @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_id, operation_kind, created_at])
}

enum student_progression_action {
  NORMAL
  REPEAT
  TRANSFER
  PAUSE
  RESUME
}

enum evaluation_status {
  DRAFT
  OPEN
  CLOSED
}

enum evaluation_participant_scope {
  ALL_ENROLLED
  SELECTED_GENERATIONS
}

enum class_type {
  COURSE
  TD
  TP
}

enum question_type {
  RATING
  TEXT
  AGREEMENT
  FREQUENCY
  MULTIPLE_CHOICE
  CHECKBOX
}

enum user_role {
  ADMIN
  LECTURER
  STUDENT
}

enum user_status {
  ACTIVE
  INACTIVE
}

enum survey_version_status {
  DRAFT
  LOCKED
  ARCHIVED
}

enum department_status {
  ACTIVE
  INACTIVE
}

enum gender {
  MALE
  FEMALE
  OTHER
}
